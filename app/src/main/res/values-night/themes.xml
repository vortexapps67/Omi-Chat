<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark counterpart of values/themes.xml. Declaring the same style names here
      with the dark platform parent is what makes the system switch themes with
      the device setting; OmiChatTheme reads isSystemInDarkTheme() and supplies
      the matching Compose colour scheme.
    -->
    <style name="Theme.OmiChat" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/omichat_blue_dark</item>
        <item name="android:navigationBarColor">@color/charcoal</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.OmiChat.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.OmiChat.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/omichat_blue_dark</item>
        <item name="android:navigationBarColor">@color/omichat_blue_dark</item>
    </style>
</resources>
