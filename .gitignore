# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
# Deliberately NOT anchored: every Gradle module has its own build directory
# (app/build, build-logic/build), so a /build/ rule would only cover the root.
/bin/
/gen/
/out/
build/

# Gradle files
.gradle/
local.properties
local.properties.template

# Environment files (contains secrets)
.env
.env.local
.env.*.local

# Signing files
/keystore/
!/keystore/release.keystore
*.keystore
!keystore/release.keystore
*.jks
*.key
signing.properties
keystore.properties
keystore.properties.template

# IDE files
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.vscode/
*.vscode

# OS files
.DS_Store
Thumbs.db

# Kotlin
*.kt.bak

# Logs
*.log

# Test reports
/reports/
/test-results/

# NOTE: source files are matched by directory, not by extension, so a source
# file added later is never silently hidden.

# Firebase
google-services.json
google-services.json.template

# Supabase
supabase.properties

# Release packaging output (dist/, dist-sources/). Anchored because
# app/build/outputs/apk/release/ is already covered by build/ above, and an
# unanchored release/ would also hide a source directory of that name.
/release/

# External native build
.externalNativeBuild/
.cxx/

# Captures
captures/

# Coverage reports
# Named after the tools that actually emit them. A blanket *.xml / *.html is
# wrong here: those are extensionless-format-agnostic patterns that match every
# XML file in the project, which silently excluded AndroidManifest.xml and all
# of app/src/main/res from the repository and broke the build on CI, where the
# resources simply were not there.
*.ec
*.lcov
/coverage/
jacoco.xml
jacoco.html
junit.xml
junit.html
lint-results*.xml
lint-results*.html

# Android Studio
*.hprof

# Gradle output captured by CI for diagnosability
gradle-*.log